[Unit]
Description=proxyfp canary server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=canary
Group=canary
WorkingDirectory=/opt/canary
EnvironmentFile=/etc/canary.env
ExecStart=/opt/canary/.venv/bin/uvicorn proxyfp.canary_server.app:app \
    --host 127.0.0.1 --port 8787 \
    --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/canary
StateDirectory=canary

[Install]
WantedBy=multi-user.target
